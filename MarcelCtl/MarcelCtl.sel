#!/usr/local/bin/Selene
-- Marcel's CLI
--
-- (c) L.Faillie (Destroyedlolo) 2024
--

local VERSION = "0.1.0"

-- Load Selene modules

Selene.Use("SelSharedVar")
Selene.Use("SelMQTT")
Selene.LetsGo()	-- ensure late building dependencies

-- SelLog.configure("/tmp/MCtl.log")

-- Load configuration
require(SELENE_SCRIPT_DIR .. "/LocalConfig")
prompt =  string.match( MQTT_URL, '://(.-).chez') .. '>  '

-- Broker's

local Brk, err = SelMQTT.Connect( MQTT_URL, { reliable=false } )
if err then
	SelLog.Log('E', "Brocker : ".. err)
	return
end

--
-- Retrieves data
--

Sections = {}
nsections = 0	-- Number of sections
ninactive = 0	-- Number of inactive sections
nerrors = 0		-- Number of sections in error

function updSection()
-- Received sections list
	local msg = SelSharedVar.Get(MARCEL ..'/Status/response')

	Sections = {}
	nsections = 0
	ninactive = 0
	nerrors = 0

	for entry in msg:gmatch("([^\n]*)\n?") do
		entry = entry .. '\t0'	-- $unnamedNotification doesn't have error field
		local name, kind, enable, inerror =  entry:match("(.-)\t(.-)\t(%d)\t(%d)")
		if not Sections[kind] then
			Sections[kind] = {}
		end
		Sections[kind][name] = {enable, inerror}
-- SelLog.Log('D', "e: ".. enable .. " err: ".. inerror .." '".. name .."'" )

		nsections = nsections + 1
		if enable == '0' then
			ninactive = ninactive + 1
		end
		if inerror == '1' then
			nerrors = nerrors + 1
		end
	end

	SelLog.Log(nsections .." Sections loaded : ".. ninactive .. " inactive, ".. nerrors .." in error")
end

function rcvChange( topic, msg )
end

Topics = {
	{topic=MARCEL ..'/Status/response', trigger=updSection, trigger_once=true},
	{topic=MARCEL ..'/Change/+', func=rcvChange}
}

_, err = Brk:Subscribe( Topics )
if err then
	SelLog.Log('E', "Subscribe : ".. err)
	return
end

-- Request current data
Brk:Publish(MARCEL ..'/Status', '')

--
-- Waiting for data
--

while true do
	local rt = table.pack( Selene.WaitFor() )

	for _,ret in ipairs(rt) do	-- An imediate function to execute ?
		if type(ret) == 'function' then
			ret()
		elseif SelError.isSelError(ret) then -- Technical error ?
			SelLog.Log('E', "Error ".. ret:getLevel() ..": ".. ret:getMessage())
		else	-- Unknown/unsupported action (dependency missing ?)
			SelLog.Log('E', "Don't know what to do with ".. type(ret))
		end
	end
end
