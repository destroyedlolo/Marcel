# Create a new TaHoma gateway

*TaHoma=MyTaHoma

	# TaHoma's own
	TaHoma_host=gateway-2095-0445-1705.local
	TaHoma_address=192.168.xx.xx
	TaHoma_port=8443

	Sample=5

	# Developer mode token
	# The token can be specified in this configuration file
#	TaHoma_token=xxxxxxxxxxxxxxxxxxxxx
	# or it can be stored externally in a file
	TaHoma_token=@/home/laurent/.tahomatoken

	# Don't verify SSL chain
	DontVerifySSL

	# start Disabled
#	Disabled

	# Disable it if running in simulation mode
#	DoNotSimulate

	desc=TaHoma with "developer mode" enabled
	ecom=Don't forget to specify the bearer code
	group=ChezMoi

	#####
	# Expected events
	#####
	# Notez_bien : directives are prepended with a 
	# 'expect_' in order to avoid confusion with top
	# level ones. Even if the goals are the same.

	**Expect=Smooze

		# Fields to segregate against incoming event
			# Event's name
		expect_Event=DeviceStateChangedEvent

			# Device's
		expect_deviceURL=io://2095-0445-1705/7011484
		
			# state's name
		expect_state=io:OneWayControllerButtonState

		# Lua validation user function
		# Arguments :
		# 	section id
		#	section event id
		# 	value
		expect_Func=ValEvent

		# Topic to publish to.
		expect_Topic=Test

		# submitted as retained message
#		expect_Retained

		# Start this state disabled
#		expect_Disabled

		# Disable this state if running in simulation mode
#		expect_DoNotSimulate
