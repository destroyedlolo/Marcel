# Create a new TaHoma gateway

*TaHoma=MyTaHoma

	# TaHoma's own
	TaHoma_host=gateway-2095-0445-1705.local
	TaHoma_address=192.168.xx.xx
	TaHoma_port=8443

	# Developer mode token
	# The token can be specified in this configuration file
#	TaHoma_token=xxxxxxxxxxxxxxxxxxxxx
	# or it can be stored externally in a file
	TaHoma_token=@/home/laurent/.tahomatoken

	# Don't verify SSL chain
	DontVerifySSL

	# start Disabled
	Disabled

	# Disable it if running in simulation mode
	DoNotSimulate

	# D2 documentations
	# Tool type comment
	desc=Don't forget to set the bearer code
	# Embedded comment
	ecom=With developer mode enabled
	# Grouping
#	group=boxes

	#####
	# Expected events
	#####
	# Notez-bien : directives are prepended with a 
	# 'expect_' in order to avoid confusion with top
	# level ones. Even if the goals are the same.


	**Expect=CO2

		# Fields to segregate against incoming event
			# Event's name
		expect_Event=DeviceStateChangedEvent

			# Device's
		expect_deviceURL=zigbee://2095-0445-1705/58849/1#3
		
			# state's name
		expect_state=core:CO2ConcentrationState

		# Lua validation user function
		# Arguments :
		# 	raw value
		# 	compensated value
		# expect_Func=ValTProbe

		# Topic to publish to.
		expect_Topic=maison/TestAirQualitySensor/CO2

		# submitted as retained message
		expect_Retained

		# Start this state disabled
		expect_Disabled

		# Disable this state if running in simulation mode
		expect_DoNotSimulate

	**Expect=Battery
		expect_Event=DeviceStateChangedEvent
		expect_deviceURL=zigbee://2095-0445-1705/58849/3
		expect_state=core:BatteryLevelState
		expect_Topic=maison/TestAirQualitySensor/Battery

	**Expect=Temperature
		expect_Event=DeviceStateChangedEvent
		expect_deviceURL=zigbee://2095-0445-1705/58849/1#1
		expect_state=core:TemperatureState
		expect_Topic=maison/TestAirQualitySensor/Temperature

	**Expect=Humidity
		expect_Event=DeviceStateChangedEvent
		expect_deviceURL=zigbee://2095-0445-1705/58849/1#2
		expect_state=core:RelativeHumidityState
		expect_Topic=maison/TestAirQualitySensor/RelativeHumidity
