# Create a new TaHoma gateway

*TaHoma=MyTaHoma

	# TaHoma's own
	TaHoma_host=gateway-2095-0445-1705.local
	TaHoma_address=192.168.xx.xx
	TaHoma_port=8443

	# Developer mode token
	TaHoma_token=xxxxxxxxxxxxxxxxxxxx

	# Don't verify SSL chain
	DontVerifySSL

	# start Disabled
	Disabled

	# Disable it if running in simulation mode
	DoNotSimulate

	# Listen for this box event's
