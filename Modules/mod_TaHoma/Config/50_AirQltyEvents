*Event=TestAirQualitySensor
	####
	# Device's
	#
	# Unlike the real events as provided by the TaHoma,
	# events MUST be grouped by the device.
	# If you create several section for the same TaHoma/Device couple,
	# only the 1st one will be considered.
	####

	# Gateway to listen
	TaHoma=Boiboite

	# Device to consider
	url=zigbee://2095-0445-1705/58849/3

	# Event's name to consider
	event=DeviceStateChangedEvent

	# Sample : Delay b/w sample in second
	# Must be > 0
	Sample=60

**State=core:TemperatureState
	# Notez_bien : directives are prepended with a 
	# 'state_' in order to avoid confusion with top
	# level ones. Even if the goals are the same.

	# Lua validation user function
	# Arguments :
	# 	raw value
	# 	compensated value
	# state_Func=ValTProbe

	# Topic to publish to.
	state_Topic=maison/TestAirQualitySensor/BatteryLevel


	# submitted as retained message
	state_Retained

	# Start this state disabled
	state_Disabled

	# Disable this state if running in simulation mode
	state_DoNotSimulate
