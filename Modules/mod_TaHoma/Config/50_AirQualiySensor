*Probe=AirQualitySensor
	####
	# settings related to the device itself
	####

	# Probe settings
	url=zigbee://2095-0445-1705/58849/1#3

	# Gateway it belongs to
	TaHoma=MyTaHoma

	# Lua validation user function
	# Arguments :
	# 	raw value
	# 	compensated value
#	Func=ValTProbe

	# Sample : Delay b/w sample
	# if -1 : only once
	Sample=30

	# Launch it immediately
	Immediate

	# Start disabled
	Disabled

	# Disable it if running in simulation mode
#	DoNotSimulate

	####
	# One of more states from the device.
	#
	# The device is queried once, then states
	# are extracted from the result.
	# The goal is to minimize the gateway's load.
	####

	#####
	# States'
	#####
	# Notez_bien : directives are prepended with a 
	# 'state_' in order to avoid confusion with top
	# level ones. Even if the goals are the same.

**State=core:BatteryLevelState
	# Not, this one doesn't exist, so nothing will be published
	# it's a test

	# Lua validation user function
	# Arguments :
	# 	raw value
	# 	compensated value
	# state_Func=ValTProbe

	# Topic to publish to.
	state_Topic=maison/TestAirQualitySensor/BatteryLevel

	# submitted as retained message
#	state_Retained

	# Start this state disabled
#	state_Disabled

	# Disable this state if running in simulation mode
	state_DoNotSimulate

**State=core:CO2ConcentrationState
	state_Topic=maison/TestAirQualitySensor/CO2
#	state_Disabled
#	state_DoNotSimulate

**State=zigbee:LinkQualityIndicatorState
	state_Topic=maison/TestAirQualitySensor/LinkQualityIndicator
	state_Disabled
#	state_DoNotSimulate
